# SchemeSathi AI Configuration

# Server Port (default: 5000)
PORT=5000

# Frontend Origin for CORS (Use '*' for development, or specific domain e.g. https://schemesathi.vercel.app in production)
FRONTEND_ORIGIN=*

# Supabase PostgreSQL Configuration (Optional: If empty, SchemeSathi runs in high-fidelity Demo Mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Assistant Integration (Optional: OpenAI, Groq, or any OpenAI-compatible provider)
# If empty, the assistant operates with fallback rule-based matching and friendly instructions.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1
